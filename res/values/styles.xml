<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppDayTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:isLightTheme">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:fontFamily">@font/xiaolai_regular</item>
        <item name="android:colorAccent">#5AC178</item>
        <item name="android:windowBackground">#FAFFFC</item>
        <item name="android:navigationBarColor">#FAFFFC</item>
        <item name="android:statusBarColor">#FAFFFC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="AppTheme" parent="AppDayTheme" />
    <style name="AppNightTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:isLightTheme">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:fontFamily">@font/xiaolai_regular</item>
        <item name="android:colorAccent">#E7D7B9</item>
        <item name="android:windowBackground">#1E1B19</item>
        <item name="android:navigationBarColor">#1E1B19</item>
        <item name="android:statusBarColor">#1E1B19</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="AppHandwriting">
        <item name="android:fontFamily">@font/xiaolai_regular</item>
    </style>
</resources>
